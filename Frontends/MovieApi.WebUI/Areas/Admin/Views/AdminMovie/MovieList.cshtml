@model List<AdminResultMovieDto>
@{
    ViewData["Title"] = "Film Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<style>
    .category-badge {
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-transform: capitalize;
    }

        .category-badge ion-icon {
            font-size: 14px;
        }

    /* Belirgin Kategori Renkleri */
    .cat-aksiyon {
        background: rgba(240, 18, 6, 0.83);
        color: #ffea00;
    }
    /* Parlak Kırmızı */
    .cat-komedi {
        background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
        color: white; 
        font-weight: 800;
    }
    /* Dram: Duygusal ve Derin (Gül Kurusu-Koyu Şarap) */
    .cat-dram {
        background: linear-gradient(135deg, #ec4899 0%, #701a75 100%);
        color: #fdf2f8;
    }
    /* Parlak Mor */
    .cat-bilimkurgu {
        background: rgba(10, 132, 255, 0.2);
        color: #0a84ff;
    }
    /* Deniz Mavisi */
    .cat-korku {
        /* Kan kırmızısından çok koyu bir siyaha geçiş */
        background: linear-gradient(135deg, #8b0000 0%, #2b0000 100%);
        color: #ff4d4d; /* Yazı rengi daha parlak bir kırmızı olsun ki okunsun */
        border: 1px solid rgba(139, 0, 0, 0.4);
        box-shadow: 0 0 10px rgba(139, 0, 0, 0.3); /* Hafif bir parlama efekti */
    }
    /* Beyaz-Gri (Karanlıkta parlar) */
    .cat-animasyon {
        background: rgba(255, 55, 125, 0.2);
        color: #ff377d;
    }
    /* Şeker Pembe */
    .cat-biyografi {
        background: rgba(172, 142, 104, 0.2);
        color: #ac8e68;
    }
    /* Bronz/Altın */
    /* Suç: Tehlikeli ve Gizemli (Turuncu-Siyah Geçişi) */
    .cat-suc {
        background: linear-gradient(135deg, #f97316 0%, #451a03 100%);
        color: #ffedd5;
        border: 1px solid rgba(249, 115, 22, 0.3);
    }
   
    /* Savaş: Askeri ve Kararlı (Haki Yeşili - Barut Grisi) */
    .cat-savas {
        background: linear-gradient(135deg, #3f4e33 0%, #2c3327 100%); /* Haki/Zeytin yeşili geçişi */
        color: #d1d5db; /* Açık gri metin */
        border-left: 4px solid #b5a442; /* Altın/Pirinç rengi rütbe detayı */
        font-weight: 700;
        letter-spacing: 0.5px;
        box-shadow: inset 0 0 5px rgba(0,0,0,0.5);
    }
    /* Fantastik: Büyülü ve Enerjik (Parlak Mor-Mavi Geçişi) */
    .cat-fantastik {
        background: linear-gradient(135deg, #8b5cf6 0%, #1e40af 100%);
        color: #e0e7ff;
        box-shadow: 0 0 8px rgba(139, 92, 246, 0.4);
    }
    /* İndigo */
    .cat-macera {
        background: rgba(100, 210, 255, 0.2);
        color: #64d2ff;
    }
    /* Gök Mavisi */
    .cat-romantik {
        background: rgba(255, 100, 130, 0.2);
        color: #ff6482;
    }
    /* Gül Rengi */
    .cat-gizem {
        /* Derin lacivertten sisli bir griye geçiş */
        background: linear-gradient(135deg, #1e3a8a 0%, #334155 100%);
        color: #94a3b8; /* Yazı rengi sisli metalik bir gri */
        border: 1px solid rgba(148, 163, 184, 0.2);
        font-style: italic; /* Gizem havası katmak için italik kullanılabilir */
    }
    /* Gümüş */
    .cat-belgesel {
        background: rgba(162, 132, 94, 0.2);
        color: #a2845e;
    }
    /* Kahve tonları */
    .cat-muzikal {
        /* Gökkuşağı renk geçişi: Kırmızıdan mora doğru */
        background: linear-gradient(45deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff, #4b0082, #8b00ff);
        color: white; /* Renkler üzerinde okunabilirlik için beyaz metin */
        font-weight: 800;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.3); /* Yazının kaybolmaması için hafif gölge */
        border: none;
    }
    /* Açık Eflatun */
    .cat-gerilim {
        background: rgba(255, 69, 58, 0.15);
        color: #ff453a;
    }
    /* Koyu Kırmızı */
    .cat-aile {
        background: rgba(0, 255, 150, 0.15);
        color: #00ff96;
    }
    /* Turkuaz */
    .cat-spor {
        background: rgba(10, 255, 255, 0.15);
        color: #0affff;
    }
    /* Cam Göbeği */
</style>

<div class="cinema-shell">
    <div class="cinema-topbar">
        <div class="d-flex align-items-start align-items-md-center justify-content-between gap-3 flex-column flex-md-row">
            <div>
                <h5 class="cinema-title">
                    <span class="badge-dot"></span>
                    Film Yönetim Paneli
                </h5>
                <div class="cinema-sub">Katalog, durum ve içerik yönetimi • sinematik görünüm</div>
            </div>

            <div class="cinema-actions">
                <div class="cinema-search">
                    <span class="search-icon">
                        <ion-icon name="search-sharp"></ion-icon>
                    </span>
                    <input class="form-control" type="text" placeholder="Film ara (adı, yıl, reyting)...">
                </div>

                <a href="/Admin/AdminMovie/CreateMovie" class="btn-cinema btn-cinema-primary">
                    <ion-icon name="add-circle-outline"></ion-icon>
                    Yeni Film Ekle
                </a>
            </div>
        </div>
    </div>

    <div class="cinema-body">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Film</th>
                        <th>Kategori</th>
                        <th>Reyting</th>
                        <th>Yıl</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        var statusText = item.Status.ToString() ?? "";
                        var isActive = statusText.Equals("True", StringComparison.OrdinalIgnoreCase) || statusText == "1";

                        // Kategori adını normalize et (Türkçe karakterleri küçült)
                        // Kategori ismini CSS class'ına ve ikon seçimine uygun hale getiriyoruz
                        var categoryNormalized = item.CategoryName?.ToLowerInvariant()
                        .Replace("ü", "u").Replace("ğ", "g").Replace("ş", "s")
                        .Replace("ç", "c").Replace("ö", "o").Replace("ı", "i")
                        .Replace(" ", "") ?? "";

                        string iconName = categoryNormalized switch
                        {
                            "aksiyon" => "flash",
                            "komedi" => "happy",
                            "dram" => "heart",
                            "bilimkurgu" => "rocket",
                            "korku" => "skull",
                            "animasyon" => "color-palette",
                            "biyografi" => "person",
                            "suc" => "finger-print",
                            "savas" => "shield-half",
                            "fantastik" => "sparkles",
                            "macera" => "map",
                            "romantik" => "rose",
                            "gizem" => "help-buoy",
                            "belgesel" => "videocam",
                            "muzikal" => "musical-notes",
                            "gerilim" => "eye",
                            "aile" => "people",
                            "spor" => "football",
                            _ => "film"
                        };

                        <tr class="cinema-row">
                            <td>@count</td>

                            <td>
                                <div class="movie-title">
                                    @item.Title
                                </div>
                            </td>

                            <td>
                                <span class="category-badge cat-@categoryNormalized">
                                    <ion-icon name="@iconName"></ion-icon>
                                    @item.CategoryName
                                </span>
                            </td>

                            <td>
                                <span class="rating-badge">
                                    <ion-icon name="star"></ion-icon>
                                    @item.Rating
                                </span>
                            </td>

                            <td class="muted">@item.CreatedYear</td>

                            <td>
                                <span class="pill @(isActive ? "on" : "off")">
                                    <span class="dot"></span>
                                    @(isActive ? "Yayında" : "Taslak")
                                </span>
                            </td>

                            <td>
                                <div class="d-flex gap-2 flex-wrap">
                                    <a href="javascript:;" class="btn-mini btn-mini-warning">
                                        <ion-icon name="create-outline"></ion-icon>
                                        Güncelle
                                    </a>
                                    <a href="javascript:;" class="btn-mini btn-mini-primary">
                                        <ion-icon name="information-circle-outline"></ion-icon>
                                        Detaylar
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>